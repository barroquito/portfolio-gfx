---
import ProjectNavigator from '../components/ProjectNavigator.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import type { Project } from '../data/projects';
import { localize, type Language } from '../data/language';
import { localizeProject } from '../data/projects-en';
import '../styles/case-interactions.css';

interface Props { language: Language; project: Project }
const { language, project: original } = Astro.props;
const t = localize(language);
const project = localizeProject(original, language);
const personal = project.slug === 'sobre-mi';
---
<Layout title={`${project.title} — Jorge Pindado`} description={project.intro} language={language} projectPage>
  <main id="main" class="case-page case-page--reel">
    <header class="case-heading section-shell">
      
      <h1 id="case-title">{project.title}</h1>
      {personal && <p class="case-summary">{project.subtitle}</p>}
    </header>
    {personal ? <section class="case-personal section-shell" aria-label={t('Sobre mí', 'About me')}>
      {(project.story ?? []).map(({ text }) => <p>{text}</p>)}
      <a class="text-link" href="/CV-Jorge-Pindado-ES.pdf" download>{t('Descargar CV', 'Download CV (Spanish)')}</a>
    </section> : <>
      <ProjectMedia project={project} language={language} />
      <section class="project-explanation section-shell" aria-label={t('Sobre el proyecto', 'About the project')}>
        <div><h2>{t('El reto', 'The challenge')}</h2><p>{project.challenge}</p></div>
        <div><h2>{t('El enfoque', 'The approach')}</h2><p>{project.approach}</p></div>
        <div><h2>{t('Mi aportación', 'My contribution')}</h2><p>{project.contribution}</p></div>
      </section>
    </>}
    <section class='case-browse section-shell' aria-label={t('Explorar proyectos', 'Explore projects')}>
      <ProjectNavigator currentSlug={project.slug} language={language} />
    </section>
  </main>
  {!personal && <dialog class="lightbox" aria-label={t('Imagen ampliada', 'Enlarged image')}><button class="lightbox-close" aria-label={t('Cerrar imagen ampliada', 'Close enlarged image')}>{t('Cerrar', 'Close')} <Icon name="close" size={60} /></button><img src="" alt="" /><p></p></dialog>}
</Layout>
<style>
  .project-explanation { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 4vw, 64px); padding-block: 36px 48px; }
  .project-explanation h2 { font-size: 1.125rem; margin-bottom: 12px; }
  .project-explanation p { font-size: 1rem; line-height: 1.65; overflow-wrap: anywhere; }
  @media(max-width:760px) { .project-explanation { grid-template-columns: 1fr; } }
  .case-heading { padding-block: 1.5rem 1rem; }
  .case-heading .back-link { margin-bottom: 1.5rem; font-size: .875rem; }
  .case-heading h1 { font-size: clamp(2.75rem, 6vw, 6rem); margin: 0; line-height: 1.05; letter-spacing: -.055em; }
  .case-summary { margin-top: .75rem; font-size: clamp(.9375rem, 1.4vw, 1.125rem); max-width: 52ch; }
  .case-personal { max-width: 850px; padding-block: 2rem 4rem; }
  .case-personal p { font-size: 1.125rem; line-height: 1.65; margin-bottom: 1.5rem; }
  @media(max-width:600px) {
    .case-heading { padding-top: 1rem; }
    .case-heading .back-link { margin-bottom: 1rem; }
  }
</style>
