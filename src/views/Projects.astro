---
import Layout from '../layouts/Layout.astro';
import { projectIndex } from '../data/projects';
import { localize, localizedPath, projectPath, type Language } from '../data/language';
import { localizeProject } from '../data/projects-en';

interface Props { language: Language }
const { language } = Astro.props;
const t = localize(language);
---
<Layout title={t('Proyectos — Jorge Pindado', 'Projects — Jorge Pindado')} description={t('Selección de proyectos de diseño gráfico y dirección de arte.', 'Selected graphic design and art direction projects.')} language={language} projectPage>
  <main id="main" class="section-shell project-index">
    <a class="back-link" href={localizedPath(language) + '#proyectos'}>{t('Volver al expositor', 'Back to the record display')}</a>
    <h1>{t('Proyectos', 'Projects')}</h1>
    <ul>
      {projectIndex.map(original => localizeProject(original, language)).map(project => <li><a href={projectPath(language, project.slug)} data-replay-project={project.slug}>
        <span><strong>{project.title}</strong><small>{project.subtitle}</small></span>
        <span aria-hidden="true">↗</span>
      </a></li>)}
    </ul>
  </main>
</Layout>
<style>
  .project-index { padding-block: clamp(5rem, 13vw, 10rem); }
  h1 { margin-block: .5em; font-size: clamp(3rem, 11vw, 9rem); line-height: .9; }
  ul { padding: 0; margin: 0; list-style: none; border-block-start: 1px solid currentColor; }
  li { border-block-end: 1px solid currentColor; }
  li a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1rem; }
  li strong { display: block; font-size: clamp(1.4rem, 4vw, 3rem); }
  li small { font-size: 1rem; }
</style>
