---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import ProjectNavigator from '../../components/ProjectNavigator.astro';
import BentoGallery from '../../components/BentoGallery.astro';
import { projects } from '../../data/projects';
import '../../styles/case-interactions.css';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
---
<Layout title={`${project.title} — Jorge Pindado`} description={project.intro}>
  <main id="main" class="case-page">
    <section class="case-heading section-shell"><a class="back-link" href="/#proyectos"> Volver a la colección</a><div class="case-topline"><span class="section-index">LADO A / DISCO {project.number}</span><span class="tiny-label">{project.context}</span></div><h1 data-reveal>{project.title}<span>/{project.number}</span></h1><div class="case-intro"><p>{project.subtitle}</p><div>{project.scope.map((tag: string) => <span class="tag">{tag}</span>)}</div></div></section>
    <div class:list={['case-cover', `case-cover--${project.theme}`]}><ProjectArtwork project={project} hero /></div>
    <section class="case-story section-shell" aria-labelledby="case-story-title"><div class="case-story-intro" data-reveal><h2 id="case-story-title">{project.intro}</h2></div><div class="case-story-grid"><div data-reveal><span class="tiny-label">01 / EL RETO</span><p>{project.challenge}</p></div><div data-reveal><span class="tiny-label">02 / EL ENFOQUE</span><p>{project.approach}</p></div><div data-reveal><span class="tiny-label">03 / MI APORTACIÓN</span><p>{project.contribution}</p></div></div>
      {!project.original && <aside class="case-note"><div><strong>Sobre esta ficha inicial</strong><p>La cubierta es una composición editorial creada para presentar el caso en este portfolio; no reproduce una pieza entregada al cliente. Las piezas originales y el desarrollo completo del proceso están pendientes de incorporarse.</p></div></aside>}
    </section>
    <BentoGallery project={project} />
    <section class="case-browse section-shell" aria-label="Explorar otros trabajos"><ProjectNavigator currentSlug={project.slug} /><a class="text-link" href="mailto:jorgepindado.gfx@gmail.com">Hablemos de un proyecto</a></section>
  </main>
  <dialog class="lightbox" aria-label="Imagen ampliada"><button class="lightbox-close" aria-label="Cerrar imagen ampliada">Cerrar <Icon name="close" size={60} /></button><img src="" alt="" /><p></p></dialog>
</Layout>
