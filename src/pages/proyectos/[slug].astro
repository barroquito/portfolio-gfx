---
import ProjectNavigator from '../../components/ProjectNavigator.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
import '../../styles/case-interactions.css';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const personal = project.slug === 'sobre-mi';
---
<Layout title={`${project.title} ÔÇö Jorge Pindado`} description={project.intro} projectPage>
  <main id="main" class="case-page case-page--reel">
    <header class="case-heading section-shell">
      
      <h1 id="case-title">{project.title}</h1>
      {personal && <p class="case-summary">{project.subtitle}</p>}
    </header>
    {personal ? <section class="case-personal section-shell" aria-label="Sobre m├¡">
      {(project.story ?? []).map(({ text }: { text: string }) => <p>{text}</p>)}
      <a class="text-link" href="/CV-Jorge-Pindado-ES.pdf" download>Descargar CV</a>
    </section> : <>
      <ProjectMedia project={project} />
    </>}
    <section class='case-browse section-shell' aria-label='Explorar proyectos'>
      <ProjectNavigator currentSlug={project.slug} />
    </section>
  </main>
  {!personal && <dialog class="lightbox" aria-label="Imagen ampliada"><button class="lightbox-close" aria-label="Cerrar imagen ampliada">Cerrar <Icon name="close" size={60} /></button><img src="" alt="" /><p></p></dialog>}
</Layout>
<style>
  .case-heading { padding-block: 1.5rem 1rem; }
  .case-heading .back-link { margin-bottom: 1.5rem; font-size: .875rem; }
  .case-heading h1 { font-size: clamp(2.75rem, 6vw, 6rem); margin: 0; line-height: 1.05; letter-spacing: -.055em; }
  .case-summary { margin-top: .75rem; font-size: clamp(.9375rem, 1.4vw, 1.125rem); max-width: 52ch; }
  .case-personal { max-width: 850px; padding-block: 2rem 4rem; }
  .case-personal p { font-size: 1.125rem; line-height: 1.65; margin-bottom: 1.5rem; }
  @media(max-width:600px) {
    .case-heading { padding-top: 1rem; }
    .case-heading .back-link { margin-bottom: 1rem; }
  }
</style>
