---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() { return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, next: projects[(index + 1) % projects.length] } })); }
const { project, next } = Astro.props;
---
<Layout title={`${project.title} — Jorge Pindado`} description={project.intro}>
  <main id="main" class="case-page">
    <section class="case-heading section-shell"><a class="back-link" href="/#proyectos"> Volver a la colección</a><div class="case-topline"><span class="section-index">LADO A / DISCO {project.number}</span><span class="tiny-label">{project.context}</span></div><h1 data-reveal>{project.title}<span>/{project.number}</span></h1><div class="case-intro"><p>{project.subtitle}</p><div>{project.scope.map((tag: string) => <span class="tag">{tag}</span>)}</div></div></section>
    <div class:list={['case-cover', `case-cover--${project.theme}`]}><ProjectArtwork project={project} hero /></div>
    <section class="case-story section-shell" aria-labelledby="case-story-title"><div class="case-story-intro" data-reveal><span class="section-index">EL PROYECTO</span><h2 id="case-story-title">{project.intro}</h2></div><div class="case-story-grid"><div data-reveal><span class="tiny-label">01 / EL RETO</span><p>{project.challenge}</p></div><div data-reveal><span class="tiny-label">02 / EL ENFOQUE</span><p>{project.approach}</p></div><div data-reveal><span class="tiny-label">03 / MI APORTACIÓN</span><p>{project.contribution}</p></div></div>
      {!project.original && <aside class="case-note"><div><strong>Sobre esta ficha inicial</strong><p>La cubierta es una composición editorial creada para presentar el caso en este portfolio; no reproduce una pieza entregada al cliente. Las piezas originales y el desarrollo completo del proceso están pendientes de incorporarse.</p></div></aside>}
    </section>
    {project.gallery.length > 0 && <section class="case-gallery section-shell" aria-label="Galería del proyecto">{project.gallery.map((item: {src:string;alt:string;caption:string}, index:number) => <figure class:list={{'gallery-wide':index === 4}} data-reveal><button class="gallery-zoom" data-src={item.src} data-alt={item.alt} aria-label={`Ampliar imagen: ${item.alt}`}><img src={item.src} alt={item.alt} loading="lazy" width={index===4?517:832} height={index===4?343:1248} />{index===0 ? <Icon name="plus" size={30} /> : <span class="zoom-label">Ampliar</span>}</button><figcaption>{item.caption}</figcaption></figure>)}</section>}
    <section class="case-next section-shell"><span class="tiny-label">SEGUIR EXPLORANDO / {next.number}</span><a href={`/proyectos/${next.slug}/`}><span>{next.title}</span><i aria-hidden="true"><Icon name="arrow" size={30} /></i></a><a class="text-link" href="mailto:jorgepindado.gfx@gmail.com">Hablemos de un proyecto </a></section>
  </main>
  <dialog class="lightbox" aria-label="Imagen ampliada"><button class="lightbox-close" aria-label="Cerrar imagen ampliada">Cerrar <Icon name="close" size={30} /></button><img src="" alt="" /><p></p></dialog>
</Layout>
