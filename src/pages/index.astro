---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import BrandMark from '../components/BrandMark.astro';
import RecordSleeve from '../components/RecordSleeve.astro';
import { projects } from '../data/projects';
import '../styles/record-room.css';
import '../styles/room-loading.css';
import '../styles/collection-orbit.css';
---
<Layout home title="Jorge Pindado — Una colección de ideas" description="Portfolio de Jorge Pindado. Diseño gráfico y dirección de arte en Madrid.">
  <main id="main" class="record-room">
    <div class="room-heading">
      <div class="room-heading-copy"><h1>Ideas en<br/><strong>rotación.</strong></h1><p>Diseño gráfico.<br/>Dirección de arte.</p></div>
      <div class="room-identity"><BrandMark tone="red" class="room-signature"/></div>
    </div>

    <section class="listening-table" aria-label="Expositor interactivo de proyectos en vinilo">
      <div id="record-scene" aria-hidden="true"></div>
      <div class="scene-fallback" aria-hidden="true"><div class="fallback-model"><img src="/models/tocadiscos-poster.webp" alt="" width="1100" height="850" /></div><div class="fallback-stack">{[...projects].reverse().map(project=><div class="fallback-sleeve"><RecordSleeve project={project}/></div>)}</div></div>
      <button class="collection-hotspot" data-open-collection aria-label="Abrir la colección de vinilos"><span class="hotspot-dot"><Icon name="plus" size={160} /></span><span class="hotspot-hint">ABRIR COLECCIÓN</span></button>

    </section>

    <div class="room-bottom"><span class="bottom-statement">CADA VINILO,<br/><strong>UN PROYECTO.</strong></span><button class="collection-main-button" data-open-collection>Explorar la colección <sup>{String(projects.length).padStart(2,'0')}</sup><i aria-hidden="true"><Icon name="arrow" size={60} /></i></button><span class="bottom-location">MADRID, ES<br/>2026</span></div>
    <p class="sr-only" id="room-status" role="status" aria-live="polite"></p>
    <div class="static-collection-links">{projects.map(project=><a href={`/proyectos/${project.slug}/`}>{project.title} </a>)}</div>
    <noscript><div class="no-js-projects"><p>Proyectos</p>{projects.map(project=><a href={`/proyectos/${project.slug}/`}>{project.title} </a>)}<a href="/CV-Jorge-Pindado-ES.pdf">Mi CV</a><a href="mailto:jorgepindado.gfx@gmail.com">Contacto</a></div></noscript>
  </main>

  <dialog id="collection-dialog" class="orbit-dialog" aria-labelledby="collection-title" aria-describedby="collection-help">
    <header class="orbit-heading">
      <div><span class="orbit-eyebrow">LADO A / LA COLECCIÓN</span><h2 id="collection-title">Elige un <strong>vinilo.</strong></h2></div>
      <button class="room-dialog-close" data-close-collection aria-label="Cerrar colección">Cerrar <Icon name="close" size={60} /></button>
    </header>
    <div class="orbit-stage" tabindex="0" role="region" aria-label="Vinilos alrededor del tocadiscos" aria-describedby="collection-help">
      <div class="orbit-fallback" aria-hidden="true">{projects.map((project,index)=><div class="orbit-fallback-record" data-fallback-record={index} hidden={index!==0}><div class="orbit-fallback-front"><RecordSleeve project={project}/></div><div class="orbit-fallback-back" style={`--sleeve-color:${project.record.color};--sleeve-ink:${project.record.ink}`}><span>LADO B / {project.number}</span><strong>{project.title}</strong><p>{project.description}</p></div></div>)}</div>
    </div>
    <footer class="orbit-footer">
      <div class="orbit-current" aria-live="polite" aria-atomic="true">
        <span class="orbit-position">01 / {String(projects.length).padStart(2,'0')}</span>
        <h3 data-orbit-title>{projects[0].title}</h3>
        <div class="orbit-copy"><p data-orbit-subtitle>{projects[0].subtitle}</p><p class="orbit-description" data-orbit-description hidden>{projects[0].description}</p></div>
      </div>
      <div class="orbit-actions">
        <button class="orbit-flip" data-orbit-flip aria-pressed="false">Ver contraportada</button>
        <a class="orbit-play" href={`/proyectos/${projects[0].slug}/`} data-orbit-play>Poner vinilo</a>
      </div>
      <div class="orbit-navigation" aria-label="Recorrer la colección">
        <button data-orbit-prev aria-label="Vinilo anterior">Anterior</button>
        <div class="orbit-index">{projects.map((project,index)=><button data-orbit-index={index} aria-label={`Seleccionar ${project.title}`} aria-current={index===0?'true':undefined}>{project.number}</button>)}</div>
        <button data-orbit-next aria-label="Vinilo siguiente">Siguiente</button>
      </div>
      <p id="collection-help" class="orbit-help">Desliza o usa el scroll para cambiar de vinilo. Pulsa la portada para darle la vuelta.</p>
    </footer>
  </dialog>

  <dialog id="contact-dialog" class="info-dialog contact-dialog" aria-labelledby="contact-dialog-title"><button class="room-dialog-close room-dialog-close--text" data-close-dialog aria-label="Cerrar contacto">Cerrar </button><h2 id="contact-dialog-title">¿Tienes algo<br/><strong>en mente?</strong></h2><div class="room-contact-email"><a href="mailto:jorgepindado.gfx@gmail.com">jorgepindado.gfx@gmail.com </a><button class="copy-email" aria-label="Copiar correo electrónico" title="Copiar correo">Copiar</button></div><div class="room-contact-links"><a href="https://www.linkedin.com/in/jorge-pindado-badiola-4a3846191/" target="_blank" rel="noopener noreferrer">LinkedIn </a><a href="/CV-Jorge-Pindado-ES.pdf" download>Descargar CV </a></div></dialog>
  <div class="record-transition" aria-hidden="true"><span class="tiny-label">AHORA EN EL PLATO</span><strong></strong><span class="record-transition-subtitle"></span><span class="transition-line"></span></div>
  <script id="record-project-data" type="application/json" set:html={JSON.stringify(projects.map(({slug,title,number,subtitle,description,record,theme})=>({slug,title,number,subtitle,description,record,theme})))}/>
  <script src="../scripts/record-room.ts"></script>
</Layout>
