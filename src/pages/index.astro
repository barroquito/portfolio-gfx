---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import BrandMark from '../components/BrandMark.astro';
import RecordSleeve from '../components/RecordSleeve.astro';
import { recordProjects as projects, projectIndex } from '../data/projects';
import { projectMedia } from '../data/project-media';
import '../styles/record-room.css';
import '../styles/collection-orbit.css';

const collectionProjects = projects.map(project => {
  const { slug, title, number, subtitle, description, record, theme, cover, gallery } = project;
  const image = gallery[0];
  const pieces = projectMedia[slug]?.flatMap(chapter => chapter.pieces) ?? [];
  const video = pieces.find(piece => piece.kind === 'video' && piece.poster);
  const still = pieces.find(piece => piece.kind === 'image');
  const preview = image ? { image: image.src, alt: image.alt }
    : video ? { image: video.poster, alt: video.label, video: video.src }
    : still ? { image: still.src, alt: still.label }
    : { image: cover, alt: title };
  return { slug, title, number, subtitle, description, record, theme, cover, preview };
});
const firstProject = collectionProjects[0];
---
<Layout home title="Jorge Pindado — Una colección de ideas" description="Portfolio de Jorge Pindado. Diseño gráfico y dirección de arte en Madrid.">
  <main id="main" class="record-room">
    <div class="room-heading">
      <div class="room-heading-copy"><h1>Ideas en<br/><strong>rotación.</strong></h1><p>Diseño gráfico.<br/>Dirección de arte.</p></div>
      <div class="room-identity"><BrandMark tone="red" class="room-signature"/></div>
    </div>

    <section class="listening-table" aria-label="Expositor interactivo de proyectos en vinilo">
      <div id="record-scene" aria-hidden="true"></div>
      <div class="scene-fallback" aria-hidden="true"><div class="fallback-model"><img src="/models/tocadiscos-poster.webp" alt="" width="1100" height="850" /></div><div class="fallback-stack">{[...projects].reverse().map(project=><div class="fallback-sleeve"><RecordSleeve project={project}/></div>)}</div></div>
      <button class="collection-hotspot" data-open-collection aria-haspopup="dialog" aria-label="Abrir la colección de vinilos"><span class="hotspot-dot"><Icon name="plus" size={160} /></span><span class="hotspot-hint">ABRIR COLECCIÓN</span></button>

    </section>

    <div class="room-bottom"><button class="collection-main-button" data-open-collection aria-haspopup="dialog">Abrir colección <i aria-hidden="true"><Icon name="arrow" size={60} /></i></button></div>
    <noscript><div class="no-js-projects"><p>Proyectos</p>{projectIndex.map(project=><a href={`/proyectos/${project.slug}/`}>{project.title} </a>)}<a href="/CV-Jorge-Pindado-ES.pdf">Mi CV</a><a href="mailto:jorgepindado.gfx@gmail.com">Contacto</a></div></noscript>
  </main>

  <dialog id="collection-dialog" class="orbit-dialog" data-render="fallback" aria-label="Colección de vinilos">
    <button class="orbit-close" type="button" data-close-collection aria-label="Cerrar colección"><Icon name="close" size={60} /></button>
    <div class="orbit-stage">
      <div class="orbit-fallback" aria-hidden="true">
        {projects.map((project,index)=><a class="orbit-fallback-record" data-fallback-record={index} href={`/proyectos/${project.slug}/`} tabindex="-1" aria-label={project.title}>
          <RecordSleeve project={project}/>
        </a>)}
      </div>
    </div>
    <div class="orbit-navigation">
      <button type="button" data-step="-1" aria-label="Vinilo anterior"><span aria-hidden="true">←</span></button>
      <button type="button" data-step="1" aria-label="Vinilo siguiente"><span aria-hidden="true">→</span></button>
    </div>
    <div class="orbit-preview">
      <div class="orbit-preview-media">
        <img data-preview-image src={firstProject.preview.image} alt={firstProject.preview.alt} decoding="async" loading="lazy" />
        <video data-preview-video muted loop playsinline preload="none" aria-hidden="true" hidden></video>
      </div>
      <a class="orbit-project" data-preview-link href={`/proyectos/${firstProject.slug}/`}>
        <span data-preview-title>{firstProject.title}</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <p class="sr-only" role="status" aria-atomic="true" data-orbit-status></p>
  </dialog>

  <dialog id="contact-dialog" class="info-dialog contact-dialog" aria-labelledby="contact-dialog-title"><button class="room-dialog-close room-dialog-close--text" data-close-dialog aria-label="Cerrar contacto">Cerrar </button><h2 id="contact-dialog-title">¿Tienes algo<br/><strong>en mente?</strong></h2><div class="room-contact-email"><a href="mailto:jorgepindado.gfx@gmail.com">jorgepindado.gfx@gmail.com </a><button class="copy-email" aria-label="Copiar correo electrónico" title="Copiar correo">Copiar</button></div><div class="room-contact-links"><a href="https://www.linkedin.com/in/jorge-pindado-badiola-4a3846191/" target="_blank" rel="noopener noreferrer">LinkedIn </a><a href="/CV-Jorge-Pindado-ES.pdf" download>Descargar CV </a></div></dialog>
  <script id="record-project-data" type="application/json" set:html={JSON.stringify(collectionProjects)}/>
  <script src="../scripts/record-room.ts"></script>
</Layout>
