---
import type { Project } from '../data/projects';
const { project } = Astro.props as { project: Project };
---
<div class="record-sleeve" style={`--sleeve-color:${project.record.color};--sleeve-ink:${project.record.ink}`} aria-hidden="true">
  {project.cover ? <img src={project.cover} alt="" width="1200" height="1200" /> : <strong>{project.title}</strong>}
</div>
<style>
  .record-sleeve img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
</style>
