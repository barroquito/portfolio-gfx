---
import { projectMedia } from '../data/project-media';
const { slug } = Astro.props as { slug: string };
const chapters = projectMedia[slug] ?? [];
---
{chapters.length > 0 && <section class="project-media section-shell" aria-labelledby="media-heading">
  <h2 id="media-heading">Piezas del proyecto</h2>
  {chapters.map(chapter => <section id={chapter.id} class="media-chapter" aria-labelledby={`chapter-${chapter.id}`}>
    <h3 id={`chapter-${chapter.id}`}>{chapter.title}</h3>
    <div class="media-grid">
      {chapter.pieces.map(piece => <figure class:list={{wide: piece.wide}}>
        {piece.kind === 'video'
          ? <video controls playsinline preload="none" poster={piece.poster} aria-label={piece.label}>
              <source src={piece.src} type="video/mp4" />
              <a href={piece.src}>{piece.label} (MP4)</a>
            </video>
          : piece.kind === 'document' ? <a class="text-link" href={piece.src} target="_blank" rel="noopener">Ver {piece.label} (PDF)</a> : <button type="button" class="gallery-zoom" data-src={piece.src} data-alt={piece.label} aria-label={`Ampliar: ${piece.label}`}>
              <img src={piece.src} alt={piece.label} loading="lazy" decoding="async" />
            </button>}
        <figcaption>{piece.label}</figcaption>
      </figure>)}
    </div>
    {chapter.link && <a class="text-link" href={chapter.link.href}>{chapter.link.label}</a>}
  </section>)}
</section>}
<style>
  .project-media { padding-block: clamp(2rem, 5vw, 5rem); }
  h2 { font-size: clamp(2rem, 5vw, 4rem); line-height: 1; }
  .media-chapter { padding-block: clamp(1.5rem, 4vw, 3rem); scroll-margin-top: 7rem; border-block-end: 1px solid var(--line); }
  h3 { font-size: clamp(1.45rem, 3vw, 2.75rem); margin-block-end: 1rem; }
  .media-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: clamp(1rem, 2.5vw, 2rem); align-items: start; }
  figure { margin: 0; min-width: 0; grid-column: span 2; }
  figure.wide { grid-column: span 3; }
  .gallery-zoom { position: static; display: block; width: 100%; height: auto; padding: 0; border: 0; background: transparent; }
  img, video { display: block; width: 100%; height: auto; }
  video { background: #202020; object-fit: contain; }
  figcaption { margin-top: .65rem; font-size: .875rem; }
  .media-chapter > a { display: inline-block; margin-top: 1.25rem; }
  @media (max-width: 740px) {
    .media-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    figure { grid-column: auto; }
    figure.wide { grid-column: 1 / -1; }
  }
  @media (max-width: 390px) {
    .media-grid { grid-template-columns: 1fr; }
  }
</style>
