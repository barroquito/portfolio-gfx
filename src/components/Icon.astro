---
interface Props {
  name: 'arrow' | 'close';
  size?: number;
  rotate?: number;
  class?: string;
}
const { name, size = 20, rotate = 0, class: className = '' } = Astro.props;
---
<span
  class:list={['user-icon', `user-icon--${name}`, className]}
  aria-hidden="true"
  style={`--icon-src:url('/icons/${name}.svg');--icon-size:${size}px;--icon-rotation:${rotate}deg`}
></span>
<style>
  .user-icon {
    display: inline-block;
    width: var(--icon-size, 20px);
    height: var(--icon-size, 20px);
    flex: 0 0 auto;
    vertical-align: -.16em;
    background: currentColor;
    -webkit-mask: var(--icon-src) center / contain no-repeat;
    mask: var(--icon-src) center / contain no-repeat;
    transform: rotate(var(--icon-rotation, 0deg));
    pointer-events: none;
  }
</style>
