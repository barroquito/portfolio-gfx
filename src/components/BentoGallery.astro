---
import type { Project } from '../data/projects';
import { getBentoGallery } from '../data/project-gallery';
interface Props { project: Project }
const { project } = Astro.props;
const placeholder = project.gallery.length === 0;
const tiles = getBentoGallery(project).map(tile => ({
  ...tile,
  rotates: !placeholder || tile.front.src !== tile.next.src,
}));
const hasMotion = tiles.some(tile => tile.rotates);
---
{tiles.length > 0 && <section class="case-gallery bento-section section-shell" aria-labelledby="gallery-heading" data-placeholder={placeholder ? 'true' : undefined}>
  <div class="bento-heading">
    <h2 id="gallery-heading">{placeholder ? 'Portada provisional' : 'En imágenes'}{!placeholder && <span>/{String(tiles.length).padStart(2, '0')}</span>}</h2>
    {hasMotion && <button type="button" class="gallery-motion" data-gallery-motion aria-pressed="true" hidden><span data-gallery-motion-label>Pausar animación</span></button>}
  </div>
  <div class="bento-gallery">
    {tiles.map((tile, index) => <figure class="bento-tile" data-index={index}>
      <button type="button" class="gallery-zoom" data-src={tile.front.src} data-alt={tile.front.alt} aria-label={`Ampliar imagen: ${tile.front.alt}`}>
        {tile.rotates ? <span class="bento-cube">
          {[tile.front, tile.next].map((face, side) => <span class:list={['bento-face', side === 0 ? 'bento-face--front' : 'bento-face--next']} data-src={face.src} data-alt={face.alt} data-caption={face.caption} aria-hidden={side === 1 ? 'true' : 'false'}>
            <img src={face.src} alt="" loading="lazy" decoding="async" width={face.width} height={face.height} style={`object-position:${face.position}`} />
          </span>)}
        </span> : <img src={tile.front.src} alt="" loading="lazy" decoding="async" width={tile.front.width} height={tile.front.height} style={`object-position:${tile.front.position}`} />}
      </button>
      <figcaption class="sr-only" data-bento-caption>{tile.front.caption}</figcaption>
    </figure>)}
  </div>
</section>}
<script>
  if (document.querySelector('.bento-cube')) void import('../scripts/bento-gallery');
</script>
