---
import Icon from './Icon.astro';
import { projectIndex } from '../data/projects';

interface Props {
  currentSlug: string;
}
const { currentSlug } = Astro.props;
---
<details class="project-navigator">
  <summary>
    <span>Todos los proyectos</span>
    <Icon name="plus" size={60} />
  </summary>
  <nav aria-label="Navegar entre proyectos">
    <ol class="project-navigator__list">
      {projectIndex.map(project => <li>
        {project.slug === currentSlug
          ? <span class="project-navigator__current" aria-current="page">
              <span class="project-navigator__number">{project.number}</span>
              <span class="project-navigator__title">{project.title}</span>
              <span class="sr-only">Proyecto actual</span>
            </span>
          : <a class="project-navigator__link" href={`/proyectos/${project.slug}/`} data-replay-project={project.cover ? project.slug : undefined}>
              <span class="project-navigator__number">{project.number}</span>
              <span class="project-navigator__title">{project.title}</span>
            </a>}
      </li>)}
    </ol>
  </nav>
</details>
<script>
  // Native case links still work when JavaScript is unavailable.
  document.querySelectorAll<HTMLAnchorElement>('[data-replay-project]').forEach(link => {
    link.href = `/?play=${encodeURIComponent(link.dataset.replayProject || '')}`;
  });

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLDetailsElement>('.project-navigator').forEach(details => {
    const panel = details.querySelector('nav');
    if (!panel || typeof panel.animate !== 'function') return;

    let opening: Animation | undefined;
    details.addEventListener('toggle', () => {
      opening?.cancel();
      opening = undefined;
      if (!details.open || reducedMotion.matches) return;
      opening = panel.animate([
        { height: '0px', overflow: 'hidden' },
        { height: `${panel.offsetHeight}px`, overflow: 'hidden' },
      ], { duration: 740, easing: 'cubic-bezier(.42, 0, .24, 1)' });
    });

    // Keyboard navigation can reach a link while the panel is still opening.
    panel.addEventListener('focusin', () => opening?.cancel());
    reducedMotion.addEventListener('change', () => opening?.cancel());
  });
</script>
