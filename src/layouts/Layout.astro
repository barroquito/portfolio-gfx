---
import '@fontsource-variable/inter';
import '../styles/global.css';
import '../styles/editorial.css';
import '../styles/type-controls.css';
import '../styles/selection.css';
import '../styles/film.css';
import BrandMark from '../components/BrandMark.astro';
import { localize, localizedPath, projectPath, type Language } from '../data/language';

interface Props {
  language?: Language;
  title?: string;
  description?: string;
  home?: boolean;
  projectPage?: boolean;
  notFound?: boolean;
}
const { language = 'es', home = false, projectPage = false, notFound = false } = Astro.props;
const t = localize(language);
const {
  title = t('Jorge Pindado — Ideas en forma', 'Jorge Pindado — Ideas in Form'),
  description = t('Diseño gráfico y dirección de arte. Del concepto publicitario a la expresión visual. Portfolio de Jorge Pindado, Madrid.', 'Graphic design and art direction. From advertising concept to visual expression. Jorge Pindado’s portfolio, Madrid.'),
} = Astro.props;
const homePath = localizedPath(language);
const alternateLanguage = language === 'es' ? 'en' : 'es';
const spanishPath = notFound ? '/' : language === 'en' ? Astro.url.pathname.slice(3) || '/' : Astro.url.pathname;
const alternatePath = localizedPath(alternateLanguage, spanishPath);
const homeLabel = t('Jorge Pindado, inicio', 'Jorge Pindado, home');
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {!notFound && (['es', 'en'] as const).map(locale => (
      <link rel="alternate" hreflang={locale} href={new URL(localizedPath(locale, spanishPath), Astro.site)} />
    ))}
    <meta name="theme-color" content="#f0ede5" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    {home && <link rel="preload" href="/models/tocadiscos.glb?v=meshopt-palette-01" as="fetch" type="model/gltf-binary" crossorigin="anonymous" />}
    <title>{title}</title>
  </head>
  <body class:list={{'listening-room':home, 'project-layout':projectPage}}>
    <a href="#main" class="skip-link">{t('Saltar al contenido', 'Skip to content')}</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <header class="site-header">
      <a class="wordmark" href={homePath} aria-label={homeLabel}>
        {projectPage ? <BrandMark /> : <span class="wordmark-name">Jorge Pindado{!home && <span>{t('Diseñador gráfico', 'Graphic designer')}</span>}</span>}
      </a>

      <button class="menu-toggle" aria-label={t('Abrir menú', 'Open menu')} aria-controls="main-nav" aria-expanded="false"><span>{t('Menú', 'Menu')}</span><i aria-hidden="true"></i></button>
      <nav id="main-nav" aria-label={t('Navegación principal', 'Main navigation')}>
        <a href={home ? '#proyectos' : homePath + '#proyectos'}>{t('Proyectos', 'Projects')}</a>
        <a href={projectPath(language, 'sobre-mi')}>{t('Sobre mí', 'About me')}</a>
        <a class="nav-contact" href={home ? '#contacto' : homePath + '#contacto'}>{t('Hablemos', 'Let’s talk')}</a>
      </nav>
      <a class="language-switch" href={alternatePath} hreflang={alternateLanguage} lang={alternateLanguage} aria-label={t('View in English', 'Ver en español')}>
        {t('EN', 'ES')}
      </a>
    </header>
    <slot />
    <footer class="site-footer"><a href={homePath} class="footer-name" aria-label={homeLabel}><BrandMark />{!projectPage && <span>Jorge Pindado</span>}</a><span>MADRID, ES · {new Date().getFullYear()}</span><a href="#main">{t('Volver arriba', 'Back to top')}</a></footer>
    <div class="toast" role="status" aria-live="polite"></div>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
<style>
  .language-switch {
    display: inline-grid;
    place-items: center;
    flex: none;
    min-width: 44px;
    min-height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    font-size: 12px;
    font-weight: 650;
    color: var(--red);
  }
  .language-switch:hover { border-color: currentColor; }
  @media (max-width: 760px) {
    .language-switch { position: relative; z-index: 2; }
  }
</style>
